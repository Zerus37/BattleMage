  selfCastComponent: {fileID: 1556247444895727117, guid: b3865b2785a15ff4cb87ce1af33a39a8,
    type: 3}
  description: "\u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435,
    \u0445\u043E\u0434 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
    \u043F\u0440\u0435\u0436\u043D\u0438\u043C, \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u043B\u0438\u0448\u044C \u0441\u0443\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0435
    \u0435\u0433\u043E \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0435
    \u043A\u043E\u043B\u0434\u0443\u043D\u043E\u043C. \u0418 \u043A\u043E\u043B\u0443\u044E\u0449\u0438\u0439
    \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043F\u0440\u0438\u043D\u044F\u0442\u044C
    \u0432\u0435\u0440\u043D\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435,
    \u0438\u043B\u0438 \u043F\u0440\u043E\u044F\u0432\u0438\u0442\u044C \u0447\u0443\u0434\u0435\u0441\u0430
    \u0440\u0435\u0430\u043A\u0446\u0438\u0438 \u043F\u043E \u043C\u043D\u0435\u043D\u0438\u044E
    \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0445. \u041D\u0430 10
    \u0441\u0435\u043A\u0443\u043D\u0434, \u0441\u0443\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0435
    \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u0441\u044F \u0432 4 \u0440\u0430\u0437\u0430."
